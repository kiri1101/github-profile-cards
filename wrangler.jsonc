{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-profile-cards",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "triggers": { "crons": ["0 */6 * * *"] },
  "kv_namespaces": [{ "binding": "STATS", "id": "fdf85e5edb6e4cc198dbac8e7a97412b" }],
  "assets": { "directory": "./public" },
  "vars": { "GITHUB_LOGIN": "kiri1101" }
}
